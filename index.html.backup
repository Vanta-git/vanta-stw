<!doctype html><html><head><meta charset="utf-8"><title>Vanta Browser</title></head><body><script>(function(){var k="VANTA_OBSCURE_2026",s="",b=atob(s),x=new Uint8Array(b.length);for(var i=0;i<b.length;i++)x[i]=b.charCodeAt(i)^k.charCodeAt(i%k.length);var d=new TextDecoder().decode(x);document.open();document.write(d);document.close()})();</script><script>
(() => {
    const threshold = 160;

    function checkDevTools() {
        const widthDiff = window.outerWidth - window.innerWidth;
        const heightDiff = window.outerHeight - window.innerHeight;

        if (widthDiff > threshold || heightDiff > threshold) {
            window.location.replace("https://www.google.com/");
        }
    }

    setInterval(checkDevTools, 500);
})();
</script><script src="/remove.js"></script></body></html>